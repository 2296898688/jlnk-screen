  farmLandUse: "农场土地利用类型面积统计",
  parcelTypeRatio: "集团宗地类型占比分析",
  regionCadastral: "相关行政区权籍调查面积统计",
  groupCadastral: "集团权籍调查面积统计"
};

if (typeof getCadastralMapFillColor !== "function") {
  const CADASTRAL_MAP_FILL_COLORS = {
    "已发证": "#047857",
    "已登记待发证": "#6ee7b7",
    "已登记未发证": "#6ee7b7",
